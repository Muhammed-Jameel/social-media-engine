{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corpus.schema.json",
  "title": "SOCIAL_MEDIA_PLUGIN Design Reference Corpus",
  "description": "Normalized, reference-only catalog for copyrighted design research. Full source images remain outside the repository; records retain identity, provenance, rights, similarity decisions, and review evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "sourcePolicy",
    "inventory",
    "fileRecords",
    "referenceAssets",
    "similarityEdges",
    "reviewSelections"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourcePolicy": {
      "$ref": "#/$defs/sourcePolicy"
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "fileRecords": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRecord"
      }
    },
    "referenceAssets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/referenceAsset"
      }
    },
    "similarityEdges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/similarityEdge"
      }
    },
    "reviewSelections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewSelection"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "mode",
        "fullSourceFilesCopied",
        "contactSheetsLocation",
        "referenceOnly",
        "doNotRedistribute",
        "allowedUses",
        "prohibitedUses"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "read-only-reference-material"
        },
        "fullSourceFilesCopied": {
          "const": false
        },
        "contactSheetsLocation": {
          "const": "design-intelligence/corpus/contact-sheets"
        },
        "referenceOnly": {
          "const": true
        },
        "doNotRedistribute": {
          "const": true
        },
        "allowedUses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "internal-research",
              "principle-extraction",
              "private-evaluation",
              "similarity-analysis"
            ]
          },
          "minItems": 1
        },
        "prohibitedUses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "publication",
              "redistribution",
              "tracing",
              "graphic-extraction",
              "identifiable-composition-copying",
              "training-data-export"
            ]
          },
          "minItems": 1
        }
      }
    },
    "inventory": {
      "type": "object",
      "description": "Counts are physical filesystem counts. The three file strata must sum to physicalFiles; archive members are not added again.",
      "additionalProperties": false,
      "required": [
        "physicalFiles",
        "primaryTopLevelImages",
        "quarantinedDerivedImages",
        "archiveContainers",
        "decodedLooseImages",
        "corruptOrUndecodable",
        "uniquePrimaryBytePayloads"
      ],
      "properties": {
        "physicalFiles": {
          "type": "integer",
          "minimum": 0
        },
        "primaryTopLevelImages": {
          "type": "integer",
          "minimum": 0
        },
        "quarantinedDerivedImages": {
          "type": "integer",
          "minimum": 0
        },
        "archiveContainers": {
          "type": "integer",
          "minimum": 0
        },
        "decodedLooseImages": {
          "type": "integer",
          "minimum": 0
        },
        "corruptOrUndecodable": {
          "type": "integer",
          "minimum": 0
        },
        "uniquePrimaryBytePayloads": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "auditMethod": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "fileRecord": {
      "oneOf": [
        {
          "$ref": "#/$defs/imageFileRecord"
        },
        {
          "$ref": "#/$defs/archiveFileRecord"
        }
      ]
    },
    "commonFileProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileId",
        "sourceRelativePath",
        "sourceStratum",
        "role",
        "bytes",
        "byteSha256"
      ],
      "properties": {
        "fileId": {
          "type": "string",
          "pattern": "^file_[0-9a-f]{10,64}$"
        },
        "sourceRelativePath": {
          "type": "string",
          "minLength": 1
        },
        "sourceStratum": {
          "enum": [
            "primary-top-level",
            "quarantined-derived",
            "archive-container"
          ]
        },
        "role": {
          "enum": [
            "primary-reference",
            "derived-thumbnail",
            "archive-container"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "byteSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "imageFileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileId",
        "referenceId",
        "sourceRelativePath",
        "sourceStratum",
        "role",
        "bytes",
        "byteSha256",
        "extension",
        "detectedFormat",
        "detectedMimeType",
        "width",
        "height",
        "aspectRatio",
        "orientation",
        "frameCount",
        "decodeStatus",
        "learningWeight"
      ],
      "properties": {
        "fileId": {
          "type": "string",
          "pattern": "^file_[0-9a-f]{10,64}$"
        },
        "referenceId": {
          "type": "string",
          "pattern": "^ref_[0-9a-f]{16,64}$"
        },
        "sourceRelativePath": {
          "type": "string",
          "minLength": 1
        },
        "sourceStratum": {
          "enum": [
            "primary-top-level",
            "quarantined-derived"
          ]
        },
        "role": {
          "enum": [
            "primary-reference",
            "derived-thumbnail"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "byteSha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonicalPixelSha256": {
          "description": "Optional hash of EXIF-normalized decoded pixels plus canonical dimensions, used to identify equivalent pixels across containers.",
          "$ref": "#/$defs/sha256"
        },
        "extension": {
          "type": "string",
          "pattern": "^\\.[A-Za-z0-9]+$"
        },
        "detectedFormat": {
          "enum": [
            "WEBP",
            "GIF",
            "JPEG",
            "PNG",
            "AVIF",
            "TIFF",
            "OTHER"
          ]
        },
        "detectedMimeType": {
          "type": "string",
          "pattern": "^image/"
        },
        "extensionMatchesPayload": {
          "type": "boolean"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "aspectRatio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reducedAspectRatio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "orientation": {
          "enum": [
            "portrait",
            "square",
            "landscape"
          ]
        },
        "colorMode": {
          "type": "string",
          "minLength": 1
        },
        "hasAlpha": {
          "type": "boolean"
        },
        "frameCount": {
          "type": "integer",
          "minimum": 1
        },
        "decodeStatus": {
          "enum": [
            "verified",
            "corrupt",
            "unsupported"
          ]
        },
        "decodeError": {
          "$ref": "#/$defs/nullableString"
        },
        "learningWeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "perceptualFeatures": {
          "$ref": "#/$defs/perceptualFeatures"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "rights": {
          "$ref": "#/$defs/rights"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceStratum": {
                "const": "primary-top-level"
              }
            },
            "required": [
              "sourceStratum"
            ]
          },
          "then": {
            "properties": {
              "role": {
                "const": "primary-reference"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sourceStratum": {
                "const": "quarantined-derived"
              }
            },
            "required": [
              "sourceStratum"
            ]
          },
          "then": {
            "properties": {
              "role": {
                "const": "derived-thumbnail"
              },
              "learningWeight": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "archiveFileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileId",
        "sourceRelativePath",
        "sourceStratum",
        "role",
        "bytes",
        "byteSha256",
        "archiveFormat",
        "memberCount",
        "verificationStatus",
        "learningWeight"
      ],
      "properties": {
        "fileId": {
          "type": "string",
          "pattern": "^file_[0-9a-f]{10,64}$"
        },
        "sourceRelativePath": {
          "type": "string",
          "minLength": 1
        },
        "sourceStratum": {
          "const": "archive-container"
        },
        "role": {
          "const": "archive-container"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "byteSha256": {
          "$ref": "#/$defs/sha256"
        },
        "archiveFormat": {
          "enum": [
            "tar",
            "tar-gzip"
          ]
        },
        "memberCount": {
          "type": "integer",
          "minimum": 0
        },
        "verificationStatus": {
          "enum": [
            "byte-exact-copy-set",
            "verified-nonduplicate",
            "mismatch",
            "unverified"
          ]
        },
        "memberTargetStratum": {
          "enum": [
            "primary-top-level",
            "quarantined-derived"
          ]
        },
        "learningWeight": {
          "const": 0
        }
      }
    },
    "perceptualFeatures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "differenceHash128": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "perceptualHash64": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "embeddingModel": {
          "type": "string",
          "minLength": 1
        },
        "embeddingVersion": {
          "type": "string",
          "minLength": 1
        },
        "embeddingRef": {
          "type": "string",
          "minLength": 1
        },
        "layoutEmbeddingModel": {
          "type": "string",
          "minLength": 1
        },
        "layoutEmbeddingRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verificationStatus"
      ],
      "properties": {
        "platform": {
          "enum": [
            "behance",
            "dribbble",
            "facebook",
            "other",
            "unknown"
          ]
        },
        "sourceUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "creatorName": {
          "$ref": "#/$defs/nullableString"
        },
        "creatorUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "projectTitle": {
          "$ref": "#/$defs/nullableString"
        },
        "collectedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "verificationStatus": {
          "enum": [
            "verified",
            "embedded-metadata-only",
            "filename-signal-only",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "licenseStatus",
        "referenceOnly",
        "doNotRedistribute",
        "doNotCopyComposition"
      ],
      "properties": {
        "licenseStatus": {
          "enum": [
            "unknown",
            "permission-recorded",
            "licensed-reference",
            "public-domain"
          ]
        },
        "referenceOnly": {
          "const": true
        },
        "doNotRedistribute": {
          "const": true
        },
        "doNotCopyComposition": {
          "const": true
        },
        "notes": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "referenceAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceId",
        "primaryFileIds",
        "derivativeFileIds",
        "aliasFileIds",
        "provenance",
        "rights",
        "analysisStatus"
      ],
      "properties": {
        "referenceId": {
          "type": "string",
          "pattern": "^ref_[0-9a-f]{16,64}$"
        },
        "primaryFileIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^file_[0-9a-f]{10,64}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "derivativeFileIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^file_[0-9a-f]{10,64}$"
          },
          "uniqueItems": true
        },
        "aliasFileIds": {
          "type": "array",
          "description": "Alternative paths with exact content; retained as evidence but assigned zero analytical weight.",
          "items": {
            "type": "string",
            "pattern": "^file_[0-9a-f]{10,64}$"
          },
          "uniqueItems": true
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "rights": {
          "$ref": "#/$defs/rights"
        },
        "filenameSignals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "visualClusterIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "analysisStatus": {
          "enum": [
            "inventory-only",
            "selected",
            "in-review",
            "reviewed",
            "rejected"
          ]
        },
        "designAnalysis": {
          "$ref": "#/$defs/designAnalysis"
        }
      }
    },
    "similarityEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeId",
        "referenceA",
        "referenceB",
        "method",
        "methodVersion",
        "proposedRelation",
        "reviewDecision",
        "humanReviewed"
      ],
      "properties": {
        "edgeId": {
          "type": "string",
          "pattern": "^edge_[0-9a-f]{12,64}$"
        },
        "referenceA": {
          "type": "string",
          "pattern": "^ref_[0-9a-f]{16,64}$"
        },
        "referenceB": {
          "type": "string",
          "pattern": "^ref_[0-9a-f]{16,64}$"
        },
        "method": {
          "enum": [
            "sha256",
            "canonical-pixel-sha256",
            "difference-hash-128",
            "perceptual-hash-64",
            "visual-embedding",
            "layout-embedding",
            "manual-review"
          ]
        },
        "methodVersion": {
          "type": "string",
          "minLength": 1
        },
        "distance": {
          "type": "number",
          "minimum": 0
        },
        "similarity": {
          "$ref": "#/$defs/unitInterval"
        },
        "proposedRelation": {
          "enum": [
            "exact-duplicate",
            "derived-thumbnail",
            "near-duplicate",
            "template-sibling",
            "same-campaign",
            "unrelated",
            "unknown"
          ]
        },
        "reviewDecision": {
          "enum": [
            "candidate",
            "confirmed",
            "rejected"
          ]
        },
        "humanReviewed": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "reviewSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceId",
        "selected",
        "analyticalWeight",
        "selectionReasons",
        "qualityReviewStatus",
        "aureNDORSuitability"
      ],
      "properties": {
        "referenceId": {
          "type": "string",
          "pattern": "^ref_[0-9a-f]{16,64}$"
        },
        "selected": {
          "type": "boolean"
        },
        "analyticalWeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "selectionReasons": {
          "type": "array",
          "items": {
            "enum": [
              "cluster-medoid",
              "cluster-boundary",
              "visual-outlier",
              "rare-arabic-signal",
              "rare-character-signal",
              "rare-3d-signal",
              "rare-editorial-signal",
              "aureNDOR-relevance",
              "quality-exemplar",
              "failure-exemplar",
              "provenance-verified"
            ]
          },
          "uniqueItems": true
        },
        "qualityReviewStatus": {
          "enum": [
            "pending",
            "strong",
            "mixed",
            "weak",
            "unusable"
          ]
        },
        "aureNDORSuitability": {
          "enum": [
            "pending",
            "high",
            "medium",
            "low",
            "none"
          ]
        },
        "templateFamilyId": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewerNotes": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "designAnalysis": {
      "type": "object",
      "description": "Structured human/multimodal analysis for selected high-value references. Claims should explain design decisions and retain evidence rather than merely tagging visible objects.",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "type": "array",
          "items": {
            "enum": [
              "awareness",
              "education",
              "promotion",
              "announcement",
              "engagement",
              "product-introduction",
              "service-explanation",
              "thought-leadership",
              "event",
              "statistic",
              "case-study",
              "storytelling",
              "brand-building",
              "conversion",
              "editorial",
              "unknown"
            ]
          },
          "uniqueItems": true
        },
        "oneSentenceStory": {
          "$ref": "#/$defs/nullableString"
        },
        "attentionSequence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hierarchy": {
          "$ref": "#/$defs/analysisDimension"
        },
        "composition": {
          "$ref": "#/$defs/analysisDimension"
        },
        "gridAndLayout": {
          "$ref": "#/$defs/analysisDimension"
        },
        "typography": {
          "$ref": "#/$defs/analysisDimension"
        },
        "arabicTypographyTransfer": {
          "$ref": "#/$defs/analysisDimension"
        },
        "color": {
          "$ref": "#/$defs/analysisDimension"
        },
        "imagery": {
          "$ref": "#/$defs/analysisDimension"
        },
        "microDetails": {
          "$ref": "#/$defs/analysisDimension"
        },
        "storytelling": {
          "$ref": "#/$defs/analysisDimension"
        },
        "elementRelationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/elementRelationship"
          }
        },
        "reusablePrinciples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/principle"
          }
        },
        "failureRisks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resolutionConfidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "reviewEvidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "analysisDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observations",
        "whyItWorks",
        "confidence"
      ],
      "properties": {
        "observations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "whyItWorks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "elementRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "effect"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "principle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principle",
        "description",
        "whyItWorks",
        "appropriateFor",
        "avoidWhen",
        "aureNDORApplication"
      ],
      "properties": {
        "principle": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "whyItWorks": {
          "type": "string",
          "minLength": 1
        },
        "appropriateFor": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "avoidWhen": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "aureNDORApplication": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
