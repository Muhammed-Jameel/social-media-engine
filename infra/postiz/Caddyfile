{$POSTIZ_HOSTNAME} {
	encode zstd gzip

	# Public hosts are probed for dotenv and repository metadata almost
	# immediately. Keep those requests away from the application entirely.
	@private_metadata path_regexp private_metadata (?i)(^|/)\.(env|git|svn|hg)($|/|\.)
	respond @private_metadata 404

	# Public TikTok ownership challenge (not an API credential).
	respond /tiktokbgF6tIc7FqgmaU4Orzg2eWvqaAjVRSlU.txt "tiktok-developers-site-verification=bgF6tIc7FqgmaU4Orzg2eWvqaAjVRSlU" 200
	respond /tiktok5bc9zMk9vUpvsLeKO1eOMz16RAXUctfC.txt "tiktok-developers-site-verification=5bc9zMk9vUpvsLeKO1eOMz16RAXUctfC" 200

	reverse_proxy postiz:5000

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
