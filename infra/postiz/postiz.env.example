POSTIZ_IMAGE_TAG=v2.23.0
POSTIZ_MAIN_URL=http://localhost:4007
POSTIZ_PORT=4007
POSTIZ_NOT_SECURED=true
# Cloud deployment only; use a hostname without https:// or a trailing slash.
POSTIZ_HOSTNAME=postiz.example.com
POSTIZ_JWT_SECRET=
POSTIZ_DATABASE_PASSWORD=
TEMPORAL_DATABASE_PASSWORD=
POSTIZ_DISABLE_REGISTRATION=false
POSTIZ_API_LIMIT=90

# Create these apps in each provider's developer portal. Never commit real values.
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Optional: only used by Postiz's own AI features.
OPENAI_API_KEY=
