[Unit]
Description=Back up the SOCIAL_MEDIA_PLUGIN Postiz deployment
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=social-media-plugin
Group=social-media-plugin
ExecStart=/opt/social-postiz/infra/postiz/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

