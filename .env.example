# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Baghdad
DEMO_MODE=true
DRY_RUN=true
PRODUCTION_PUBLISHING_ENABLED=false
# Neutral runtime variables (legacy SOCIAL_MEDIA_PLUGIN_* names are also supported)
SOCIAL_ENGINE_ORGANIZATION_ID=org-social-media-plugin
SOCIAL_ENGINE_OWNER_ID=user-owner
SOCIAL_MEDIA_SOURCE_ROOT=
SOCIAL_ENGINE_PAUSED=false
SOCIAL_ENGINE_CREATIVE_PRODUCTION_PAUSED=false
SOCIAL_MEDIA_PLUGIN_ENGINE_PAUSED=false
# Deployment fail-safe. The durable database release gate is closed by default.
SOCIAL_MEDIA_PLUGIN_CREATIVE_PRODUCTION_PAUSED=false

# Owner authentication (required when DEMO_MODE=false)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD_HASH=
OWNER_SESSION_SECRET=

# Database. Leave DATABASE_URL empty to use local PGlite.
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# Model policy
OPENAI_API_KEY=
OPENAI_FRONTIER_MODEL=gpt-5.6-sol
OPENAI_EFFICIENT_MODEL=gpt-5.6-terra
OPENAI_INPUT_COST_PER_MILLION_USD=
OPENAI_OUTPUT_COST_PER_MILLION_USD=
OPENAI_RATE_CARD_VERIFIED_AT=

# Credential encryption for persisted OAuth tokens (production only)
CREDENTIAL_ENCRYPTION_KEY=

# Self-hosted Postiz bridge. The API key is created in Postiz after first sign-in.
POSTIZ_FRONTEND_URL=http://localhost:4007
POSTIZ_API_URL=http://localhost:4007/api
POSTIZ_API_KEY=
# Set true only after TikTok approves the configured Direct Post application.
POSTIZ_TIKTOK_DIRECT_POST_VERIFIED=false

# Canva Connect
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://localhost:3000/api/oauth/canva/callback

# Meta / Instagram / Facebook
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/oauth/meta/callback

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/oauth/linkedin/callback

# TikTok (manual draft handoff is the default integration policy)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/oauth/tiktok/callback

# S3 / Cloudflare R2 compatible storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Notifications
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
OWNER_NOTIFICATION_EMAIL=
