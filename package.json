{
  "name": "social-content-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SOCIAL_MEDIA_PLUGIN's evidence-led social media operating system.",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "campaign:production": "tsx scripts/campaign-production.mts",
    "dev": "pnpm db:migrate && pnpm db:seed && pnpm brand:sync && pnpm seed:import && pnpm plan:september && pnpm --filter @social-media-plugin/web dev",
    "worker": "pnpm --filter @social-media-plugin/worker dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint apps packages scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:seed": "tsx scripts/seed.mts",
    "seed:e2e": "tsx scripts/seed-e2e.mts",
    "seed:import": "tsx scripts/import-existing-content.mts",
    "creative:benchmarks": "tsx scripts/generate-creative-benchmarks.mts",
    "creative:round3:aggregate": "tsx scripts/build-round3-critique-sets.mts",
    "creative:source-backed": "tsx scripts/render-source-backed-cohort.mts",
    "creative:source-backed:audit": "tsx scripts/audit-source-backed-cohort.mts",
    "creative:source-backed:dashboard": "tsx scripts/verify-source-backed-dashboard.mts",
    "plan:september:render": "tsx scripts/render-september-plan-covers.mts && tsx scripts/render-september-launch-day.mts",
    "plan:launch-day:render": "tsx scripts/render-september-launch-day.mts",
    "plan:september": "pnpm plan:september:render && tsx scripts/sync-september-creative-plan.mts",
    "simulate:dry-run": "tsx scripts/simulate-dry-run.mts",
    "discovery": "node scripts/discover-brand.mts",
    "brand:sync": "tsx scripts/sync-brand-index.mts",
    "postiz:setup": "tsx scripts/setup-postiz.mts",
    "postiz:repair-admin": "tsx scripts/reset-postiz-admin.mts",
    "postiz:lock": "tsx scripts/setup-postiz.mts --lock",
    "postiz:up": "pnpm postiz:setup && docker compose --env-file .postiz/.env -f infra/postiz/docker-compose.yml up -d",
    "postiz:down": "docker compose --env-file .postiz/.env -f infra/postiz/docker-compose.yml down",
    "postiz:logs": "docker compose --env-file .postiz/.env -f infra/postiz/docker-compose.yml logs -f postiz",
    "secrets:check": "tsx scripts/check-secrets.mts",
    "check": "pnpm secrets:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "social:sync": "tsx scripts/social-operations.mts sync",
    "social:status": "tsx scripts/social-operations.mts status",
    "social:schedule": "tsx scripts/social-schedule.mts"
  },
  "devDependencies": {
    "@social-media-plugin/db": "workspace:*",
    "@social-media-plugin/engine": "workspace:*",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
